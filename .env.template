# ==========================================
# Severus Voice AI Backend Configuration
# ==========================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (CometAPI, OpenRouter, or OpenAI)
# For CometAPI (Recommended for voice: gemini-3.8-flash or gpt-6-astra):
COMETAPI_KEY=your_cometapi_key_here
LLM_BASE_URL=https://api.cometapi.com/v1
LLM_MODEL=gemini-3.8-flash
LLM_MAX_TOKENS=512
# Top CometAPI models for voice:
# - gemini-3.8-flash (Fastest TTFT, ultra-efficient, excellent tool calling)
# - gpt-6-astra (OpenAI flagship for deep reasoning)
# - gpt-5.6 (Balanced high capability)
# - claude-fable-5-1 / claude-sonnet-5 (Natural human tone and agent execution)
# - auto (CometAPI automatic intelligent routing)

# AssemblyAI Realtime STT Configuration
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Master Secret for WebAuthn Biometric Enrollment
SEVERUS_MASTER_SECRET=your_super_secret_passphrase_here

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# WebPush / VAPID Notification Keys (Run scripts/generate_vapid.py to generate)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Web Search Provider (Optional - Tavily or Serper)
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
